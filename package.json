{
  "name": "survivor-stage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sfx-preview": "vite --config tools/sfx_preview/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/run-production-build.mjs",
    "build:vite": "tsc && vite build",
    "build:cloudflare": "VITE_SURVIVOR_SUPPORT_LINK_ENABLED=true npm run build:vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sfx-preview": "vitest run --config tools/sfx_preview/vitest.config.ts",
    "generate:sfx": "npm --prefix tools/sfx_designer run generate --",
    "inspect:bgm": "tools/sfx_designer/node_modules/.bin/tsx tools/bgm_inspector/src/inspect.ts",
    "sync:audio-library": "node tools/audio_library/sync.mjs",
    "test:e2e:autoplay": "playwright test tests/e2e/survivor-autoplay.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "happy-dom": "15.11.7",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "phaser": "^3.80.1"
  }
}
